{
  "name": "mythos",
  "version": "1.1.0",
  "description": "Suite bureautique locale synchronisée sans serveur",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win",
    "dist:linux": "vite build && electron-builder --linux AppImage tar.gz",
    "android": "vite build && npx cap sync android"
  },
  "keywords": [],
  "author": "Mythos",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-collaboration": "^3.32.0",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "docx": "^9.14.0",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "xlsx": "^0.18.5",
    "y-indexeddb": "^9.0.12",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.5"
  },
  "productName": "Mythos",
  "build": {
    "appId": "com.mythos.suite",
    "productName": "Mythos",
    "files": [
      "dist/**",
      "electron/main.cjs",
      "electron/preload.cjs",
      "build/icon.png"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Mythos-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Mythos-Portable-${version}.exe"
    },
    "linux": {
      "target": [
        "tar.gz"
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "artifactName": "Mythos-${version}-${arch}.${ext}"
    }
  }
}